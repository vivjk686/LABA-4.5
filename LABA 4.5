#include <iostream>
#include <iomanip>
#include <cmath>
#include <time.h>

using namespace std;

int main()
{
	double x, y, R;

	srand((unsigned)time(NULL));

	cout << "R = "; cin >> R;

	// 1 спосіб: координати вводяться з клавіатури
	for (int i = 0; i < 10; i++)
	{
		cout << "x = "; cin >> x;
		cout << "y = "; cin >> y;

		if ((x >= -R && x <= 0 && y >= 0 && y <= R &&
			pow(x + R, 2) + pow(y - R, 2) >= pow(R, 2)) ||
			(x >= 0 && x <= R && y >= -R && y <= 0 &&
				pow(x - R, 2) + pow(y + R, 2) >= pow(R, 2)))
			cout << "yes" << endl;
		else
			cout << "no" << endl;
	}

	cout << endl << fixed;

	// 2 спосіб: координати випадкові з інтервалу [-R; R]
	for (int i = 0; i < 10; i++)
	{
		x = 2. * R * rand() / RAND_MAX - R;
		y = 2. * R * rand() / RAND_MAX - R;

		if ((x >= -R && x <= 0 && y >= 0 && y <= R &&
			pow(x + R, 2) + pow(y - R, 2) >= pow(R, 2)) ||
			(x >= 0 && x <= R && y >= -R && y <= 0 &&
				pow(x - R, 2) + pow(y + R, 2) >= pow(R, 2)))
			cout << setw(8) << setprecision(4) << x << "  "
			<< setw(8) << setprecision(4) << y << "  " << "yes" << endl;
		else
			cout << setw(8) << setprecision(4) << x << "  "
			<< setw(8) << setprecision(4) << y << "  " << "no" << endl;
	}

	return 0;
}
